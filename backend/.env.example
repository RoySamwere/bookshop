APP_NAME="Hekima Bookshop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bookshop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Verification, password reset and approval emails.
# With MAIL_MAILER=log nothing is sent: each email (and its link) is written to storage/logs/laravel.log.
# For real delivery set MAIL_MAILER=smtp and fill in your provider's SMTP details, e.g.
#   MAIL_HOST=smtp.your-provider.com  MAIL_PORT=587  MAIL_SCHEME=null (STARTTLS) or smtps (port 465)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local System Owner bootstrap. Set a strong password only in backend/.env.
SYSTEM_OWNER_NAME="Roy Sam"
SYSTEM_OWNER_EMAIL="roy@bookshop.com"
SYSTEM_OWNER_PASSWORD=

# Platform Owner bootstrap, used only by `php artisan platform:owner`. Use an address that is not a
# bookshop account, and remove the password once the account exists.
PLATFORM_OWNER_NAME="Platform Owner"
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=

# Free-trial length for newly registered bookshops (the Platform Owner can override it in settings),
# and the subscription_plans.code new bookshops start on.
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_DEFAULT_PLAN=starter
# Minutes a staff invitation link stays valid (default 3 days).
STAFF_INVITATION_EXPIRE=4320

# React frontend used in password reset, verification and approval email links.
FRONTEND_URL=http://127.0.0.1:5173
# Comma-separated origins allowed to call the API from a browser.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# The site's own domain (APP_URL, FRONTEND_URL, FRONTEND_ORIGINS and the API host) is always trusted for sign-in.
# On the live server also list it here, e.g. hekimabookshop.co.ke,www.hekimabookshop.co.ke
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:3000,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000
# Set true in production with HTTPS. Keep the frontend and API on the same site.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Sign-in token lifetimes in minutes: normal sign-in, and "Remember me" (also the hard maximum).
SANCTUM_TOKEN_EXPIRATION=720
SANCTUM_REMEMBER_EXPIRATION=10080
# Minutes an email verification link stays valid.
AUTH_VERIFICATION_EXPIRE=1440

# Subscription M-Pesa. Use a dedicated staging database for sandbox testing.
# Sandbox payments never activate or extend subscription access.
MPESA_ENVIRONMENT=sandbox
MPESA_SHORTCODE=174379
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
# Automatic verification of Paybill payments before they are credited:
#   transaction_status (default) needs an API initiator; pull_api needs Safaricom Pull API access; none = operator review.
MPESA_C2B_VERIFICATION=transaction_status
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_RESULT_URL=https://hekimabookshop.co.ke/api/v1/billing/mpesa/transaction-status/result
MPESA_TIMEOUT_URL=https://hekimabookshop.co.ke/api/v1/billing/mpesa/transaction-status/timeout
MPESA_C2B_CONFIRMATION_URL=https://hekimabookshop.co.ke/api/v1/billing/mpesa/c2b/confirmation
MPESA_C2B_VALIDATION_URL=https://hekimabookshop.co.ke/api/v1/billing/mpesa/c2b/validation
# Optional: comma-separated Safaricom callback IPs; when set, verification results from other IPs are ignored.
MPESA_CALLBACK_IPS=
# Production shortcode must be the platform Paybill 152451.
