# Copy to .env.local and adjust. Restart npm run dev (or rebuild) after changes.

# Laravel API base URL.
VITE_API_URL=/api/v1

# Brand shown on the public website, sign-in pages and management system.
VITE_BRAND_NAME="Hekima Bookshop"
VITE_BRAND_SHORT_NAME="Hekima"

# Public contact details. Leave a line empty to hide it; nothing is shown until you fill these in.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_ADDRESS=
VITE_CONTACT_HOURS=
